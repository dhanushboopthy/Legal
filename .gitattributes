# Files that end up inside Linux containers (nginx config, shell, Python) must
# keep LF line endings even when the repo is cloned on Windows, where git
# would otherwise convert them to CRLF. Windows scripts get CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.pdf binary
