ENVIRONMENT=development
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# docker-compose creates the database with these; DATABASE_URL must match.
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=legal_pass
POSTGRES_DB=legal_filing
DATABASE_URL=postgresql+asyncpg://legal_user:legal_pass@db:5432/legal_filing

# docker-compose starts Redis with this password and builds REDIS_URL from it
# for the api and worker. Generate with: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# The web/bff services in docker-compose.yml proxy same-origin through
# nginx, so the browser never actually needs this — it only matters if
# something calls the API directly from a different origin (e.g. local
# frontend dev servers not going through the nginx proxy).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Document storage. docker-compose runs a self-hosted S3-compatible store
# (SeaweedFS, service "storage") — the two keys below are the credentials it
# is started with AND the ones the api signs URLs with, so invent them:
#   AWS_ACCESS_KEY_ID=lfp$(openssl rand -hex 8)
#   AWS_SECRET_ACCESS_KEY=$(openssl rand -hex 24)
# To use real AWS S3 (or any other S3-compatible store) instead, put its keys
# here, leave S3_ENDPOINT_URL empty for AWS, and drop the storage service.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=legal-filing-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
# Browsers upload/download straight to the store via presigned URLs, so this
# must be an address the BROWSER can reach (not the docker-internal
# hostname). Local: http://localhost:8333. Production: its public https URL.
S3_ENDPOINT_URL=http://localhost:8333
# Origins allowed to call the store from a browser (CORS), comma-separated —
# the URL(s) the web app is served from.
STORAGE_ALLOWED_ORIGINS=http://localhost:3000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Identity Services "Sign in with Google". GOOGLE_CLIENT_ID (backend,
# used only to check the audience on incoming credentials) and
# VITE_GOOGLE_CLIENT_ID (frontend, passed as a docker-compose build arg to
# the web image — see docker-compose.yml) must be the SAME value, from the
# same OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# SMTP for the registration email-OTP. Any standard provider (Gmail app
# password, Zoho, etc.) works. Leave SMTP_HOST empty in dev — with DEBUG=true
# the OTP code is logged server-side instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Shown on the Help page and the sign-in screen. Leave empty to hide.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=Monday to Saturday, 10 am to 6 pm

REVIEW_FEE_INR=100
# The advocate sets the price of each draft; the server keeps it inside this range.
QUOTE_MIN_INR=100
QUOTE_MAX_INR=100000
# Intake limits: per file, files per case, total per case.
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_CASE=10
MAX_CASE_SIZE_MB=100

# The worker deletes a draft case (and its files) nobody submitted for this long.
DRAFT_RETENTION_DAYS=7
WORKER_INTERVAL_SECONDS=60

# The admin-approval gate stays manual, but a pending registration this old
# nudges its admin(s) by email, at most once per gap.
PENDING_APPROVAL_REMINDER_AFTER_HOURS=48
PENDING_APPROVAL_REMINDER_GAP_HOURS=24
