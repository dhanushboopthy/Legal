# Production settings for docker-compose.prod.yml. deploy/windows/start.ps1
# copies this to .env.production on first run and fills in every value marked
# GENERATED with a fresh random secret. Fill in each CHANGE_ME yourself; the
# script won't start the service while any are left. Never commit
# .env.production: it holds every secret the service has.

ENVIRONMENT=production
DEBUG=false

APP_BASE_URL=https://srikrishnlegaloffice.in
CORS_ORIGINS=https://srikrishnlegaloffice.in

SECRET_KEY=GENERATED
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=legal_user
POSTGRES_PASSWORD=GENERATED
POSTGRES_DB=legal_filing
# Must match the three values above (start.ps1 writes it for you).
DATABASE_URL=GENERATED

REDIS_PASSWORD=GENERATED

# Document storage (SeaweedFS, inside docker). Browsers upload and download
# straight from it, through the tunnel's second hostname.
AWS_ACCESS_KEY_ID=GENERATED
AWS_SECRET_ACCESS_KEY=GENERATED
AWS_REGION=ap-south-1
S3_BUCKET_NAME=legal-filing-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
S3_ENDPOINT_URL=https://files.srikrishnlegaloffice.in
STORAGE_ALLOWED_ORIGINS=https://srikrishnlegaloffice.in

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the token
# in the "docker run" command (the long value after --token).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Razorpay dashboard, in Live mode: Account & Settings -> API Keys, and
# Webhooks (URL https://srikrishnlegaloffice.in/api/webhooks/razorpay).
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Optional: "Sign in with Google". Both the same OAuth client id, with
# https://srikrishnlegaloffice.in as an authorised JavaScript origin. Leave
# both empty to hide the button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email for sign-up codes, password resets and notifications. For Gmail, use
# an app password (Google account -> Security -> App passwords).
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME
SMTP_USE_TLS=true

# Shown on the Help page and the sign-in screen. Leave empty to hide.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=Monday to Saturday, 10 am to 6 pm

REVIEW_FEE_INR=100
QUOTE_MIN_INR=100
QUOTE_MAX_INR=100000
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_CASE=10
MAX_CASE_SIZE_MB=100

DRAFT_RETENTION_DAYS=7
WORKER_INTERVAL_SECONDS=60
PENDING_APPROVAL_REMINDER_AFTER_HOURS=48
PENDING_APPROVAL_REMINDER_GAP_HOURS=24
